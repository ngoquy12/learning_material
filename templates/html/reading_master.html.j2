<!doctype html>
<html lang="vi">
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <title>
      {{ lesson_title }} - Rikkei Education
    </title>

    <!-- Google Fonts -->
    <link rel="preconnect" href="https://fonts.googleapis.com" />
    <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin />
    <link
      href="https://fonts.googleapis.com/css2?family=Inter:wght@400;500;600;700;800&family=Montserrat:wght@700;800&family=JetBrains+Mono:wght@400;500;700&display=swap"
      rel="stylesheet"
    />

    <!-- Phosphor Icons -->
    <script src="https://unpkg.com/@phosphor-icons/web"></script>

    <!-- Tailwind CSS -->
    <script src="https://cdn.tailwindcss.com"></script>
    <script>
      tailwind.config = {
        theme: {
          extend: {
            colors: {
              rikkei: {
                red: "#be111c",
                darkred: "#90000a",
                dark: "#0f172a",
              },
            },
            fontFamily: {
              sans: ["Inter", "system-ui", "sans-serif"],
              montserrat: ["Montserrat", "sans-serif"],
              mono: ["JetBrains Mono", "monospace"],
            },
            maxWidth: {
              340: "1680px",
            },
          },
        },
      };
    </script>

    <!-- Highlight.js for Syntax Highlighting (Light theme only) -->
    <link
      rel="stylesheet"
      href="https://cdnjs.cloudflare.com/ajax/libs/highlight.js/11.9.0/styles/github.min.css"
    />
    <script src="https://cdnjs.cloudflare.com/ajax/libs/highlight.js/11.9.0/highlight.min.js"></script>
    {% if hljs_languages %}
      {% for lang in hljs_languages %}
    <script src="https://cdnjs.cloudflare.com/ajax/libs/highlight.js/11.9.0/languages/{{ lang }}.min.js"></script>
      {% endfor %}
    {% else %}
    <script src="https://cdnjs.cloudflare.com/ajax/libs/highlight.js/11.9.0/languages/python.min.js"></script>
    <script src="https://cdnjs.cloudflare.com/ajax/libs/highlight.js/11.9.0/languages/javascript.min.js"></script>
    <script src="https://cdnjs.cloudflare.com/ajax/libs/highlight.js/11.9.0/languages/java.min.js"></script>
    <script src="https://cdnjs.cloudflare.com/ajax/libs/highlight.js/11.9.0/languages/cpp.min.js"></script>
    <script src="https://cdnjs.cloudflare.com/ajax/libs/highlight.js/11.9.0/languages/sql.min.js"></script>
    {% endif %}

    {% if engine_type == 'pyodide' %}
    <!-- Pyodide Engine for Live Wasm Python Sandbox -->
    <script src="https://cdn.jsdelivr.net/pyodide/v0.25.0/full/pyodide.js"></script>
    {% elif engine_type == 'sql_sim' %}
    <!-- AlaSQL Engine for In-Browser SQL Execution -->
    <script src="https://cdn.jsdelivr.net/npm/alasql@4"></script>
    {% endif %}

    <style>
      /* Custom Thin Scrollbar for Terminal Console Log */
      #viz-terminal-log::-webkit-scrollbar {
        width: 5px;
      }
      #viz-terminal-log::-webkit-scrollbar-track {
        background: #020617;
        border-radius: 4px;
      }
      #viz-terminal-log::-webkit-scrollbar-thumb {
        background: #334155;
        border-radius: 4px;
      }
      #viz-terminal-log::-webkit-scrollbar-thumb:hover {
        background: #475569;
      }

      html {
        scroll-behavior: smooth;
        scroll-padding-top: 84px; /* Problem 2.2: Fixed Header clearance */
      }

      /* 1. SVG DIAGRAM - Prevent text overflow, ensure responsive */
      .rikkei-diagram,
      svg.rikkei-diagram {
        max-width: 100%;
        height: auto;
        display: block;
        overflow: hidden;
      }
      .rikkei-diagram text,
      svg.rikkei-diagram text {
        font-family: "Inter", system-ui, sans-serif;
        overflow: hidden;
      }
      .diagram-wrap {
        width: 100%;
        max-width: 100%;
        overflow: hidden;
        border-radius: 0.75rem;
      }
      div.my-6 svg,
      section svg,
      article svg {
        max-width: 100%;
        height: auto;
        overflow: hidden;
      }

      /* 2. TABLE - Prevent table overflow on all screens */
      table {
        width: 100%;
        border-collapse: collapse;
        table-layout: fixed;
        word-wrap: break-word;
      }

      th,
      td {
        padding: 0.75rem;
        border: 1px solid #e2e8f0;
      }

      th {
        background-color: #f1f5f9;
        font-weight: 600;
        color: #0f172a;
      }

      /* 3. CODE BLOCK FIXES */
      pre code {
        display: block;
        font-family: "JetBrains Mono", monospace;
        font-size: 0.875rem;
        line-height: 1.6;
        background-color: #f8fafc;
        color: #0f172a;
      }

      /* 3. LIGHT MODE STYLING & HIGH CONTRAST TEXT RULES */
      h1,
      h2,
      h3,
      h4,
      h5,
      h6 {
        color: #0f172a !important;
        font-style: normal !important;
      }
      p,
      li,
      td,
      th,
      span,
      div {
        font-style: normal;
      }
      /* STRICT ZERO ITALIC LEAKAGE SAFETY NET */
      article p:not(.italic):not(.img-caption),
      article li,
      article div:not(.img-caption-box),
      article table,
      article blockquote,
      article strong,
      article b,
      article h1,
      article h2,
      article h3,
      article h4,
      article h5,
      article h6 {
        font-style: normal !important;
      }
      article p.italic,
      article figcaption,
      article .img-caption {
        font-style: italic !important;
      }
      .toc-link,
      .mobile-toc-link {
        color: #475569 !important;
        font-style: normal !important;
      }
      .toc-link:hover,
      .mobile-toc-link:hover {
        color: #0f172a !important;
      }
      .bg-amber-50 *,
      .bg-rose-50 *,
      .bg-emerald-50 *,
      .bg-sky-50 * {
        color: #1e293b !important;
      }

      /* VISUALIZER HIGH CONTRAST LIGHT MODE & SYNTAX TOKEN SAFETY NET */
      [id*="mech"] p,
      [id*="mech"] div,
      [id*="visualizer"] div {
        color: #1e293b;
      }
      [id*="mech-line"]:not(.active-line),
      [id*="line-"]:not(.active-line) {
        color: #475569 !important;
        opacity: 1 !important;
        font-weight: 500 !important;
      }
      .kw {
        color: #cf222e !important;
        font-weight: bold !important;
      }
      .str {
        color: #0a3069 !important;
      }
      .num {
        color: #0550ae !important;
        font-weight: 600 !important;
      }
      .fn {
        color: #8250df !important;
        font-weight: 600 !important;
      }
      .cmt {
        color: #6e7781 !important;
        font-style: italic !important;
      }

      code:not(.hljs):not([class*="language"]) {
        background-color: #f1f5f9 !important;
        color: #be111c !important;
        padding: 0.125rem 0.375rem !important;
        border-radius: 0.25rem !important;
        font-family: "JetBrains Mono", monospace !important;
        font-size: 0.875rem !important;
      }

      /* 4. CODE SANDBOX & HLJS SYNTAX HIGHLIGHTING */
      .sandbox-editor {
        min-height: 6rem;
        font-family: "JetBrains Mono", monospace;
        font-size: 0.875rem;
        line-height: 1.6;
        background-color: #f8fafc;
        color: #0f172a;
      }

      pre code.hljs {
        padding: 1.25rem !important;
        border-radius: 0.75rem !important;
        font-family: "JetBrains Mono", monospace !important;
        font-size: 0.875rem !important;
        line-height: 1.6 !important;
        background: #f8fafc !important;
      }

      pre span,
      code span {
        background-color: transparent !important;
      }

      pre {
        white-space: pre-wrap;
        word-break: break-all;
        overflow-wrap: break-word;
      }

      /* 9. STRAY CHARACTER PREVENTION */
      body
        > *:not(header):not(main):not(script):not(style):not(
          #mobile-toc-toggle
        ):not(#mobile-toc-drawer) {
        display: none !important;
      }
    </style>
  </head>
  <body
    class="bg-slate-50 text-base text-slate-800 font-sans leading-relaxed transition-colors duration-300 min-h-screen"
  >
    <!-- Fixed Header -->
    <header
      class="fixed top-0 left-0 right-0 h-16 bg-white/95 backdrop-blur-md border-b border-slate-200 z-40"
    >
      <div
        class="max-w-[1680px] mx-auto h-full px-6 flex items-center justify-between"
      >
        <div class="flex items-center gap-4">
          <img
            src="https://rikkei.edu.vn/wp-content/uploads/2025/09/Logo.png"
            alt="Rikkei Academy Logo"
            class="h-9 object-contain"
          />
          <span
            class="text-sm font-semibold text-slate-500 border-l border-slate-300 pl-4"
            >{{ lesson_title }}</span
          >
        </div>
      </div>
      <div class="w-full h-1 bg-slate-100">
        <div
          id="scroll-progress"
          class="h-full w-0 bg-rikkei-red transition-all duration-75"
        ></div>
      </div>
    </header>

    <!-- Main Container -->
    <main class="max-w-[1680px] mx-auto px-6 pt-24 pb-16 flex gap-8">
      <!-- Sidebar Table of Contents (Left Desktop) -->
      <aside
        class="w-80 shrink-0 hidden lg:block sticky top-24 h-[calc(100vh-120px)] overflow-y-auto pr-2"
      >
        <div class="space-y-4">
          <h4
            class="font-montserrat font-bold text-sm text-slate-700 uppercase tracking-wider flex items-center gap-2"
          >
            <i class="ph-bold ph-list-bullets text-rikkei-red"></i> Mục lục bài
            đọc
          </h4>
          <nav
            class="flex flex-col border-l border-slate-200 space-y-1 text-sm"
          >
            <a
              href="#section-1"
              class="toc-link pl-4 py-1.5 border-l-2 border-transparent text-slate-600 hover:text-slate-900 font-semibold transition-all"
              >1. {{ section_titles.sec1 or 'Đặt vấn đề thực tế' }}</a
            >
            <a
              href="#section-2"
              class="toc-link pl-4 py-1.5 border-l-2 border-transparent text-slate-600 hover:text-slate-900 font-semibold transition-all"
              >2. {{ section_titles.sec2 or 'Cú pháp và cơ chế hoạt động' }}</a
            >
            <a
              href="#section-3"
              class="toc-link pl-4 py-1.5 border-l-2 border-transparent text-slate-600 hover:text-slate-900 font-semibold transition-all"
              >3. {{ section_titles.sec3 or 'Các ví dụ ứng dụng thực tiễn' }}</a
            >
            <a
              href="#section-4"
              class="toc-link pl-4 py-1.5 border-l-2 border-transparent text-slate-600 hover:text-slate-900 font-semibold transition-all"
              >4. {{ section_titles.sec4 or 'Tổng kết bài học' }}</a
            >
            <a
              href="#section-5"
              class="toc-link pl-4 py-1.5 border-l-2 border-transparent text-slate-600 hover:text-slate-900 font-semibold transition-all"
              >5. {{ section_titles.sec5 or 'Tài liệu tham khảo' }}</a
            >
          </nav>
        </div>
      </aside>

      <!-- Problem 2.3: Mobile Floating TOC Button (lg:hidden) -->
      <button
        id="mobile-toc-toggle"
        onclick="toggleMobileToc()"
        class="lg:hidden fixed bottom-6 right-6 z-50 bg-rikkei-red text-white p-3.5 rounded-full shadow-xl hover:scale-105 transition-all flex items-center justify-center border border-white/20"
        title="Mở mục lục bài đọc"
      >
        <i class="ph-bold ph-list text-xl"></i>
      </button>

      <!-- Problem 2.3: Mobile TOC Slide-over Modal Drawer -->
      <div
        id="mobile-toc-drawer"
        class="lg:hidden fixed inset-0 z-50 bg-slate-900/60 backdrop-blur-sm hidden transition-all duration-300"
      >
        <div
          class="fixed inset-y-0 right-0 w-80 max-w-[85vw] bg-white p-6 shadow-2xl overflow-y-auto flex flex-col justify-between"
        >
          <div>
            <div
              class="flex items-center justify-between pb-4 mb-4 border-b border-slate-200"
            >
              <h4
                class="font-montserrat font-bold text-base text-slate-900 flex items-center gap-2"
              >
                <i class="ph-bold ph-list-bullets text-rikkei-red"></i> MỤC LỤC
                BÀI ĐỌC
              </h4>
              <button
                onclick="toggleMobileToc()"
                class="p-1 rounded text-slate-400 hover:text-slate-600"
              >
                <i class="ph-bold ph-x text-lg"></i>
              </button>
            </div>
            <nav class="flex flex-col space-y-2 text-sm">
              <a
                href="#section-1"
                onclick="toggleMobileToc()"
                class="mobile-toc-link p-2 rounded-lg text-slate-700 font-semibold hover:bg-slate-100"
                >1. {{ section_titles.sec1 or 'Đặt vấn đề thực tế' }}</a
              >
              <a
                href="#section-2"
                onclick="toggleMobileToc()"
                class="mobile-toc-link p-2 rounded-lg text-slate-700 font-semibold hover:bg-slate-100"
                >2. {{ section_titles.sec2 or 'Cú pháp và cơ chế hoạt động' }}</a
              >
              <a
                href="#section-3"
                onclick="toggleMobileToc()"
                class="mobile-toc-link p-2 rounded-lg text-slate-700 font-semibold hover:bg-slate-100"
                >3. {{ section_titles.sec3 or 'Các ví dụ ứng dụng thực tiễn' }}</a
              >
              <a
                href="#section-4"
                onclick="toggleMobileToc()"
                class="mobile-toc-link p-2 rounded-lg text-slate-700 font-semibold hover:bg-slate-100"
                >4. {{ section_titles.sec4 or 'Tổng kết bài học' }}</a
              >
              <a
                href="#section-5"
                onclick="toggleMobileToc()"
                class="mobile-toc-link p-2 rounded-lg text-slate-700 font-semibold hover:bg-slate-100"
                >5. {{ section_titles.sec5 or 'Tài liệu tham khảo' }}</a
              >
            </nav>
          </div>
          <div class="pt-4 border-t border-slate-200 text-xs text-slate-400 text-center">
            Rikkei Education - Learning Material
          </div>
        </div>
      </div>

      <!-- Main Reading Article Content -->
      <article class="flex-1 min-w-0 bg-white border border-slate-200 rounded-2xl p-6 sm:p-10 shadow-sm">
        <!-- Main Title Header (Exact Match to Benchmark Lesson 03) -->
        <div class="border-b border-slate-200 pb-6 mb-8">
          <h1 class="font-montserrat font-bold text-3xl text-slate-900 leading-tight">
            {{ lesson_clean_title }}
          </h1>
        </div>

        <!-- SECTION 1: PROBLEM STATEMENT -->
        <section id="section-1" class="mb-10 scroll-mt-24">
          <h2 class="font-montserrat font-bold text-2xl text-slate-900 mb-4">
            1. {{ section_titles.sec1 or 'Đặt vấn đề thực tế' }}
          </h2>
          <div class="space-y-4">
            {{ sec1_html | safe }}
          </div>

          {% if sec1_visual_html %}
          {{ sec1_visual_html | safe }}
          {% elif context_image_url %}
          <div class="my-6 text-center">
            <img src="{{ context_image_url }}" alt="Minh họa bối cảnh thực tế" class="w-full max-w-3xl h-auto mx-auto rounded-xl shadow-sm border border-slate-200" onerror="this.closest('.my-6').style.display='none';" />
            <p class="text-center text-sm text-slate-500 italic mt-3">Hình 1.1: Sơ đồ bối cảnh thực tế bài học: {{ lesson_clean_title }}</p>
          </div>
          {% endif %}
        </section>

        <!-- SECTION 2: SYNTAX & MECHANISM BREAKDOWN -->
        <section id="section-2" class="mb-10 scroll-mt-24">
          <h2 class="font-montserrat font-bold text-2xl text-slate-900 mb-4">
            2. {{ section_titles.sec2 or 'Cú pháp và cơ chế hoạt động' }}
          </h2>

          <div class="space-y-4">
            {{ sec2_html | safe }}
          </div>

          {% if visualizer_component_html and not ('id="sec-2-4' in sec2_html or 'viz-step-badge' in sec2_html or 'viz-code-display' in sec2_html or 'Mô phỏng cơ chế vận hành từng bước' in sec2_html) %}
          <!-- Domain Adaptive Step-by-Step Visualizer -->
          <div class="my-8">
            {{ visualizer_component_html | safe }}
          </div>
          {% endif %}
        </section>

        <!-- SECTION 3: PROGRESSIVE EXAMPLES -->
        <section id="section-3" class="mb-10 scroll-mt-24">
          <h2 class="font-montserrat font-bold text-2xl text-slate-900 mb-4">
            3. {{ section_titles.sec3 or 'Các ví dụ ứng dụng thực tiễn' }}
          </h2>

          <div class="space-y-6">
            {{ sec3_html | safe }}
          </div>
        </section>

        <!-- SECTION 4: GOTCHAS & PITFALLS -->
        <section id="section-4" class="mb-10 scroll-mt-24">
          <h2 class="font-montserrat font-bold text-2xl text-slate-900 mb-4">
            4. {{ section_titles.sec4 or 'Tổng kết bài học' }}
          </h2>

          <div class="space-y-4">
            {{ sec4_html | safe }}
          </div>
        </section>

        <!-- SECTION 5: REFERENCES -->
        <section id="section-5" class="mb-10 scroll-mt-24">
          <h2 class="font-montserrat font-bold text-2xl text-slate-900 mb-4">
            5. {{ section_titles.sec5 or 'Tài liệu tham khảo' }}
          </h2>

          <div class="pt-2">
            <ul class="space-y-2 list-none pl-0">
              {% for ref in reference_links %}
              <li>
                <a href="{{ ref.url }}" target="_blank" rel="noopener noreferrer" class="text-rikkei-red hover:underline inline-flex items-center gap-2 font-medium">
                  <i class="ph-bold ph-link text-sm"></i> {{ ref.title }}
                </a>
              </li>
              {% endfor %}
            </ul>
          </div>

          <!-- Self-Test Component -->
          {% if self_test_questions %}
          <div id="selftest-section" class="mt-8 pt-6 border-t border-slate-200">
            <h3 class="font-montserrat font-bold text-lg text-slate-900 mb-4 flex items-center gap-2">
              <i class="ph-bold ph-checks text-rikkei-red"></i> Câu hỏi ôn tập
            </h3>
            <p class="text-sm text-slate-600 mb-6">Trả lời các câu hỏi nhanh dưới đây để kiểm tra mức độ hiểu biết của bạn về kịch bản và ví dụ thực tế trong bài đọc này!</p>

            <form id="self-test-form" onsubmit="event.preventDefault(); checkSelfTest();" class="space-y-6">
              {% for q in self_test_questions %}
              {% set q_idx = loop.index %}
              <div class="selftest-item p-4 rounded-xl border border-slate-200 bg-slate-50/50 space-y-3">
                <p class="selftest-question text-sm font-semibold text-slate-800 flex items-start gap-2" style="justify-content: flex-start !important; gap: 8px !important; text-align: left !important;">
                  <span class="px-2 py-0.5 rounded bg-slate-200 text-slate-800 text-xs font-bold">{{ q_idx }}</span>
                  <span>{{ q.question }}</span>
                </p>
                <div class="space-y-2">
                  {% for opt in q.options %}
                  {% set opt_letter = opt[:1] %}
                  <label class="selftest-answer flex items-center justify-content-start gap-2 text-left p-2.5 rounded-lg border border-slate-200 bg-white hover:bg-slate-50 cursor-pointer text-sm text-slate-700 w-full" style="text-align: left !important;">
                    <input type="radio" name="q{{ q_idx }}" value="{{ opt_letter }}" class="w-4 h-4 text-rikkei-red focus:ring-rikkei-red shrink-0" />
                    <span class="text-left" style="text-align: left !important;">{{ opt }}</span>
                  </label>
                  {% endfor %}
                </div>
                <div id="q{{ q_idx }}-explanation" class="hidden text-xs p-3 rounded-lg mt-2 leading-relaxed text-left" style="text-align: left !important;"></div>
              </div>
              {% endfor %}

              <!-- Button Submit -->
              <div class="flex items-center justify-between gap-4">
                <button type="submit" id="btn-check-selftest" class="px-5 py-2.5 rounded-lg bg-rikkei-red hover:bg-rikkei-darkred text-white font-semibold text-sm shadow-md transition-all flex items-center gap-2">
                  <i class="ph-bold ph-check text-base"></i> Kiểm tra kết quả
                </button>
                <div id="self-test-score" class="hidden text-sm font-semibold text-slate-700"></div>
              </div>
            </form>
          </div>
          {% endif %}
        </section>
      </article>
    </main>

    <!-- Scripts -->
    <script>
      hljs.highlightAll();

      window.addEventListener("scroll", () => {
        const winScroll = document.documentElement.scrollTop;
        const height = document.documentElement.scrollHeight - document.documentElement.clientHeight;
        const scrolled = (winScroll / height) * 100;
        document.getElementById("scroll-progress").style.width = scrolled + "%";
      });

      function toggleMobileToc() {
        const drawer = document.getElementById("mobile-toc-drawer");
        drawer.classList.toggle("hidden");
      }

      // JavaScript Live In-Browser Sandbox Engine
      function runJsCode(editorId, outputId, containerId) {
        const editor = document.getElementById(editorId);
        const output = document.getElementById(outputId);
        const container = document.getElementById(containerId);
        if (!editor || !output) return;

        if (container) container.classList.remove("hidden");
        const rawCode = editor.innerText || editor.textContent;
        output.innerText = "";

        let logs = [];
        const originalLog = console.log;
        const originalWarn = console.warn;
        const originalError = console.error;
        const originalInfo = console.info;

        try {
          console.log = function(...args) {
            logs.push(args.map(a => (typeof a === 'object' ? JSON.stringify(a, null, 2) : String(a))).join(' '));
            originalLog.apply(console, args);
          };
          console.info = console.log;
          console.warn = function(...args) {
            logs.push("[CẢNH BÁO] " + args.map(a => (typeof a === 'object' ? JSON.stringify(a, null, 2) : String(a))).join(' '));
            originalWarn.apply(console, args);
          };
          console.error = function(...args) {
            logs.push("[LỖI] " + args.map(a => (typeof a === 'object' ? JSON.stringify(a, null, 2) : String(a))).join(' '));
            originalError.apply(console, args);
          };

          const result = new Function(rawCode)();
          if (result !== undefined && logs.length === 0) {
            logs.push(String(result));
          }

          if (logs.length > 0) {
            output.innerText = logs.join('\n');
          } else {
            output.innerText = "Thực thi thành công (Không có dữ liệu xuất console).";
          }
        } catch (err) {
          output.innerText = "LỖI THỰC THI JAVASCRIPT:\n" + (err && err.stack ? err.stack : err);
        } finally {
          console.log = originalLog;
          console.warn = originalWarn;
          console.error = originalError;
          console.info = originalInfo;
        }
      }

      // Pyodide Live Wasm Sandbox Engine
      let pyodideInstance = null;
      async function getPyodide() {
        if (!pyodideInstance && window.loadPyodide) {
          pyodideInstance = await window.loadPyodide();
        }
        return pyodideInstance;
      }

      async function runPythonCode(editorId, outputId, containerId) {
        const editor = document.getElementById(editorId);
        const output = document.getElementById(outputId);
        const container = document.getElementById(containerId);
        if (!editor || !output) return;

        if (container) container.classList.remove("hidden");
        const code = editor.innerText || editor.textContent;
        output.innerText = "Đang khởi tạo trình thông dịch Pyodide Wasm...";

        try {
          const pyodide = await getPyodide();
          if (!pyodide) {
            output.innerText = "Không thể kết nối Pyodide Wasm Sandbox.";
            return;
          }
          let outputBuffer = "";
          pyodide.setStdout({
            batched: (str) => { outputBuffer += str + "\n"; }
          });
          pyodide.setStderr({
            batched: (str) => { outputBuffer += "ERROR: " + str + "\n"; }
          });

          try {
            await pyodide.runPythonAsync("import sys; [sys.modules['__main__'].__dict__.pop(k) for k in list(sys.modules['__main__'].__dict__.keys()) if not k.startswith('__') and k not in ('sys', 'pyodide')]");
          } catch(e) {}

          await pyodide.runPythonAsync(code);
          output.innerText = outputBuffer.trim() ? outputBuffer.trim() : (outputBuffer || "Thực thi thành công (Không có kết quả xuất console).");
        } catch (err) {
          output.innerText = "LỖI THỰC THI:\n" + err;
        }
      }

      function clearSandbox(editorId, outputId, containerId) {
        const editor = document.getElementById(editorId);
        const output = document.getElementById(outputId);
        const container = document.getElementById(containerId);
        if (editor) {
          const orig = editor._originalText || editor.getAttribute("data-original");
          if (orig) {
            editor.textContent = orig;
            editor.removeAttribute("data-highlighted");
            if (window.hljs) hljs.highlightElement(editor);
          }
        }
        if (output) output.innerText = "";
        if (container) container.classList.add("hidden");
      }

      document.addEventListener("DOMContentLoaded", () => {
        document.querySelectorAll("code[data-original]").forEach((codeEl) => {
          if (!codeEl._originalText) {
            codeEl._originalText = codeEl.textContent;
          }
        });
      });

      function copySandboxCode(editorId, btn) {
        const editor = document.getElementById(editorId);
        if (!editor) return;
        const text = editor.innerText || editor.textContent;
        navigator.clipboard.writeText(text).then(() => {
          const origContent = btn.innerHTML;
          btn.innerHTML = '<i class="ph-bold ph-check text-emerald-500 text-sm"></i>';
          setTimeout(() => { btn.innerHTML = origContent; }, 2000);
        }).catch(err => {
          console.error("Lỗi copy code:", err);
        });
      }

      {% if engine_type == 'sql_sim' %}
      function runSqlCode(editorId, outputId, btnElement) {
        const codeElement = document.getElementById(editorId);
        const outputElement = document.getElementById(outputId);
        if (!codeElement || !outputElement) return;

        const sqlText = codeElement.innerText || codeElement.value;
        try {
          const res = alasql(sqlText);
          outputElement.innerText = "KẾT QUẢ TRUY VẤN SQL:\n" + JSON.stringify(res, null, 2);
        } catch (err) {
          outputElement.innerText = "LỖI THỰC THI SQL:\n" + err.message;
        }
      }
      {% endif %}

      {% if self_test_questions %}
      function checkSelfTest() {
        const answers = {{ self_test_answers_json | safe }};
        const explanations = {{ self_test_explanations_json | safe }};

        let score = 0;
        const total = Object.keys(answers).length;

        for (let i = 1; i <= total; i++) {
          const qId = "q" + i;
          const selected = document.querySelector(`input[name="${qId}"]:checked`);
          const expDiv = document.getElementById(`${qId}-explanation`);
          
          if (!expDiv) continue;
          expDiv.classList.remove("hidden");
          
          const correctAns = answers[i];
          const explainText = explanations[i];
          
          if (selected) {
            const val = selected.value;
            if (val === correctAns) {
              score++;
              expDiv.className = "text-xs p-3 rounded-lg mt-2 bg-emerald-50 text-emerald-800 border border-emerald-200 font-medium text-left";
              expDiv.innerHTML = `<i class="ph-bold ph-check-circle text-emerald-600 mr-1.5 text-sm align-middle"></i> <strong>Đúng!</strong> ${explainText}`;
            } else {
              expDiv.className = "text-xs p-3 rounded-lg mt-2 bg-rose-50 text-rose-800 border border-rose-200 font-medium text-left";
              expDiv.innerHTML = `<i class="ph-bold ph-x-circle text-rose-600 mr-1.5 text-sm align-middle"></i> <strong>Sai!</strong> Đáp án đúng là <strong>${correctAns}</strong>. ${explainText}`;
            }
          } else {
            expDiv.className = "text-xs p-3 rounded-lg mt-2 bg-amber-50 text-amber-800 border border-amber-200 font-medium text-left";
            expDiv.innerHTML = `<i class="ph-bold ph-warning text-amber-600 mr-1.5 text-sm align-middle"></i> Bạn chưa chọn câu trả lời cho câu này.`;
          }
        }

        const scoreDiv = document.getElementById("self-test-score");
        if (scoreDiv) {
          scoreDiv.classList.remove("hidden");
          scoreDiv.innerText = `Kết quả: ${score}/${total} câu trả lời đúng.`;
        }
      }
      {% endif %}

      // Visualizer logic for Section 2.4 Step-by-Step Tracker
      var currentVizStep = 0;
      var vizAutoInterval = null;

      function runVizStep(stepNum) {
        const codeDisplay = document.getElementById("viz-code-display");
        if (!codeDisplay) return;
        const lineDivs = codeDisplay.querySelectorAll("div[id^='viz-line-']");
        const linesCount = lineDivs.length;
        const totalSteps = (window.vizSteps && window.vizSteps.length > 0) ? window.vizSteps.length : linesCount;

        if (stepNum === -999) {
          currentVizStep = 0;
          if (vizAutoInterval) {
            clearInterval(vizAutoInterval);
            vizAutoInterval = null;
            const autoBtn = document.getElementById("viz-auto-btn");
            if (autoBtn) autoBtn.innerText = "Tự động chạy";
          }
        } else if (stepNum === -1) {
          currentVizStep = Math.max(0, currentVizStep - 1);
        } else if (stepNum === 1) {
          currentVizStep = Math.min(totalSteps, currentVizStep + 1);
        } else {
          currentVizStep = stepNum;
        }

        // Reset highlights & badges
        lineDivs.forEach((el) => {
          el.className = "p-1.5 rounded transition-all duration-200 flex items-center justify-between font-mono text-xs whitespace-pre";
        });
        document.querySelectorAll("[id^='viz-badge-']").forEach((b) => {
          b.classList.add("hidden");
          b.innerText = "";
        });

        const term = document.getElementById("viz-terminal-log");
        const badge = document.getElementById("viz-step-badge");

        if (currentVizStep === 0) {
          if (term) term.innerHTML = `<div class="text-slate-400 italic">&gt; Sẵn sàng mô phỏng từng bước. Bấm 'Tiếp theo' để bắt đầu...</div>`;
          if (badge) {
            badge.innerText = "Sẵn sàng";
            badge.className = "px-2 py-0.5 bg-slate-200 text-slate-700 text-[11px] rounded font-sans";
          }
          updateRamMonitor(0);
          return;
        }

        if (badge) {
          badge.innerText = `Bước ${currentVizStep}/${totalSteps}`;
          badge.className = "px-2 py-0.5 bg-amber-100 text-amber-800 text-[11px] rounded font-bold font-sans border border-amber-300";
        }

        if (window.vizSteps && window.vizSteps[currentVizStep - 1]) {
          const stepData = window.vizSteps[currentVizStep - 1];
          const activeLine = stepData.line;
          const el = document.getElementById("viz-line-" + activeLine);
          if (el) {
            el.className = "p-1.5 rounded transition-all duration-200 flex items-center justify-between font-mono text-xs whitespace-pre bg-amber-50 border-l-4 border-amber-500 font-semibold text-slate-900 shadow-sm";
            // Show inline badge if present
            const lineBadge = document.getElementById("viz-badge-" + activeLine);
            if (lineBadge && stepData.badge) {
              lineBadge.innerText = stepData.badge;
              lineBadge.classList.remove("hidden");
            }
          }
          updateRamMonitor(currentVizStep);
          if (term) {
            term.innerHTML = "";
            for (let step = 1; step <= currentVizStep; step++) {
              const sData = window.vizSteps[step - 1];
              if (sData && sData.log) {
                term.innerHTML += `<div class="text-slate-800 font-mono text-xs">${sData.log}</div>`;
              }
            }
            term.scrollTop = term.scrollHeight;
          }
        } else {
          // Fallback if window.vizSteps is not set
          const activeEl = document.getElementById("viz-line-" + currentVizStep);
          if (activeEl) {
            activeEl.className = "p-1.5 rounded transition-all duration-200 flex items-center justify-between font-mono text-xs whitespace-pre bg-amber-50 border-l-4 border-amber-500 font-semibold text-slate-900 shadow-sm";
            if (term) {
              term.innerHTML = `<div class="text-slate-800 font-mono text-xs">&gt; [Bước ${currentVizStep}] Thực thi dòng lệnh ${currentVizStep}</div>`;
            }
          }
        }
      }

      function updateRamMonitor(stepIdx) {
        // Reset all RAM entries to --- if stepIdx is 0
        if (stepIdx === 0) {
          const ramEls = document.querySelectorAll("[id^='viz-ram-']");
          ramEls.forEach((el) => {
            if (el.id !== "viz-ram-status" && el.id !== "viz-ram-env" && el.id !== "viz-ram-lesson") {
              el.innerText = "---";
              el.className = "font-bold text-slate-700 px-2.5 py-0.5 rounded bg-white border border-slate-200 min-w-[60px] text-center transition-all duration-300";
            }
          });
          return;
        }

        if (!window.vizSteps || !window.vizSteps[stepIdx - 1]) return;
        const stepData = window.vizSteps[stepIdx - 1];
        if (stepData && stepData.ram) {
          for (const [key, val] of Object.entries(stepData.ram)) {
            const ramEl = document.getElementById("viz-ram-" + key);
            if (ramEl) {
              const oldVal = ramEl.innerText;
              ramEl.innerText = val;
              if (oldVal !== val && oldVal !== "---") {
                ramEl.className = "font-bold text-emerald-800 px-2.5 py-0.5 rounded bg-emerald-100 border border-emerald-300 min-w-[60px] text-center transition-all duration-300 scale-105";
                setTimeout(() => {
                  if (ramEl) ramEl.className = "font-bold text-slate-800 px-2.5 py-0.5 rounded bg-white border border-slate-200 min-w-[60px] text-center transition-all duration-300";
                }, 800);
              } else {
                ramEl.className = "font-bold text-slate-800 px-2.5 py-0.5 rounded bg-white border border-slate-200 min-w-[60px] text-center transition-all duration-300";
              }
            }
          }
        }
      }

      function vizToggleAuto() {
        const btn = document.getElementById("viz-auto-btn");
        if (!btn) return;
        
        const codeDisplay = document.getElementById("viz-code-display");
        if (!codeDisplay) return;
        const lineDivs = codeDisplay.querySelectorAll("div[id^='viz-line-']");
        const linesCount = lineDivs.length;
        const totalSteps = (window.vizSteps && window.vizSteps.length > 0) ? window.vizSteps.length : linesCount;

        if (vizAutoInterval) {
          clearInterval(vizAutoInterval);
          vizAutoInterval = null;
          btn.innerText = "Tự động chạy";
        } else {
          btn.innerText = "Tạm dừng";
          if (currentVizStep >= totalSteps) runVizStep(-999);
          runVizStep(1);
          vizAutoInterval = setInterval(() => {
            if (currentVizStep >= totalSteps) {
              clearInterval(vizAutoInterval);
              vizAutoInterval = null;
              btn.innerText = "Tự động chạy";
            } else {
              runVizStep(1);
            }
          }, 1800);
        }
      }

      // Active TOC link on scroll using IntersectionObserver
      document.addEventListener("DOMContentLoaded", () => {
        const observerOptions = {
          root: null,
          rootMargin: "-20% 0px -60% 0px",
          threshold: 0
        };

        const observer = new IntersectionObserver((entries) => {
          entries.forEach((entry) => {
            if (entry.isIntersecting) {
              const id = entry.target.getAttribute("id");
              // Deactivate all TOC links in sidebar and drawer
              document.querySelectorAll(".toc-link, .mobile-toc-link").forEach((link) => {
                link.classList.remove("border-rikkei-red", "text-rikkei-red", "font-bold", "bg-slate-100");
                link.classList.add("border-transparent", "text-slate-600");
              });
              // Activate current links
              const activeLinks = document.querySelectorAll(`a[href="#${id}"]`);
              activeLinks.forEach((link) => {
                if (link.classList.contains("toc-link")) {
                  link.classList.add("border-rikkei-red", "text-rikkei-red", "font-bold");
                  link.classList.remove("border-transparent", "text-slate-600");
                } else if (link.classList.contains("mobile-toc-link")) {
                  link.classList.add("text-rikkei-red", "bg-slate-100");
                }
              });
            }
          });
        }, observerOptions);

        document.querySelectorAll("section[id^='section-']").forEach((section) => {
          observer.observe(section);
        });
      });
    </script>
  </body>
</html>
