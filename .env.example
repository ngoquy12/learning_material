# ==============================================================================
# ELEVISION / ELEARNING FACTORY — MẪU CẤU HÌNH MÔI TRƯỜNG (.env.example)
# ==============================================================================

# ------------------------------------------------------------------------------
# 1. CẤU HÌNH GEMINI LLM ROUTER (CHỌN 1 TRONG 2 CHẾ ĐỘ DƯỚI ĐÂY)
# ------------------------------------------------------------------------------

# CHẾ ĐỘ 1: Dùng Local Gemini Proxy (Antigravity Proxy @ 127.0.0.1:8045)
USE_REAL_GEMINI_API_KEY=false
GEMINI_API_KEY=sk-your-proxy-key-here
GEMINI_BASE_URL=http://127.0.0.1:8045
GEMINI_MODEL=gemini-3.6-flash-high

# CHẾ ĐỘ 2: Dùng API Key thật của Google Gemini (Google AI Studio / Vertex AI)
# Khi USE_REAL_GEMINI_API_KEY=true, hệ thống sẽ tự động bỏ qua proxy và gọi trực tiếp Google AI SDK
# USE_REAL_GEMINI_API_KEY=true
# GEMINI_API_KEY=AIzaSyYourRealGoogleApiKeyHere
# GEMINI_MODEL=gemini-1.5-flash

# ------------------------------------------------------------------------------
# 2. CẤU HÌNH OPENAI (TÙY CHỌN FALLBACK)
# ------------------------------------------------------------------------------
# OPENAI_API_KEY=sk-your-openai-key
# LLM_MODEL=gpt-4o-mini

# ------------------------------------------------------------------------------
# 3. CẤU HÌNH CƠ SỞ DỮ LIỆU & CACHE
# ------------------------------------------------------------------------------
# DATABASE_URL=postgresql://postgres:postgres@localhost:5432/elearning_factory
# DB_POOL_SIZE=5
SEMANTIC_CACHE_ENABLED=false
CACHE_SIMILARITY_THRESHOLD=0.88
CACHE_MAX_AGE_DAYS=30

# ------------------------------------------------------------------------------
# 4. CẤU HÌNH SANDBOX THỰC THI CODE
# ------------------------------------------------------------------------------
SANDBOX_PROVIDER=docker
SANDBOX_STRICT=false
SANDBOX_TIMEOUT=5
# E2B_API_KEY=e2b_your_api_key

# ------------------------------------------------------------------------------
# 5. CẤU HÌNH GIÁM SÁT OBSERVABILITY (LANGFUSE / OTEL)
# ------------------------------------------------------------------------------
# LANGFUSE_PUBLIC_KEY=pk-lf-...
# LANGFUSE_SECRET_KEY=sk-lf-...
# LANGFUSE_HOST=https://cloud.langfuse.com

# ------------------------------------------------------------------------------
# 6. THƯ MỤC LƯU TRỮ DỮ LIỆU RUNTIME (SQLite checkpoint / cache / kho tri thức)
# ------------------------------------------------------------------------------
# Mặc định: <gốc dự án>/storage. Đường dẫn tương đối được hiểu là tương đối so với
# gốc dự án (KHÔNG phải thư mục làm việc hiện tại), nên chạy CLI từ đâu cũng trỏ về
# đúng một bộ dữ liệu. Đặt biến này khi chạy trong container hoặc khi muốn tách
# dữ liệu của từng môi trường.
# STORAGE_DIR=storage

# ------------------------------------------------------------------------------
# 7. KIỂM ĐỊNH PHẠM VI KIẾN THỨC NGỮ NGHĨA (TẦNG 2)
# ------------------------------------------------------------------------------
# Tầng 1 (đối sánh từ khoá) luôn chạy, rẻ và tất định. Tầng 2 dùng chính model
# Gemini đang cấu hình để bắt các vi phạm mà từ khoá không thấy: từ đồng nghĩa
# tiếng Việt ("tập hợp" thay cho set), hoặc dùng khái niệm mà không gọi tên nó.
# Tầng 2 CHỈ chạy khi tầng 1 không phát hiện gì, và tốn thêm một lượt gọi LLM cho
# mỗi artifact được cho qua — vì vậy mặc định TẮT, bật khi chấp nhận chi phí đó.
# SCOPE_AUDIT_SEMANTIC=true
